        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper sendet Ihnen täglich inspirierende Zitate als Benachrichtigungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper will send you inspirational quotes as daily notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper le enviará citas inspiradoras como notificaciones diarias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper vous enverra des citations inspirantes sous forme de notifications quotidiennes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisperは毎日、インスピレーションを与える名言を通知でお届けします。"
