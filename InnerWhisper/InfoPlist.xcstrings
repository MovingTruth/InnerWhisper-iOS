        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper가 매일 영감을 주는 인용구를 알림으로 전해드립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Inner Whisper enviará citações inspiradoras como notificações diárias."
          }
