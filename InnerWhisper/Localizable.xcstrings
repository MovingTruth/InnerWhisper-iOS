    "No remote quotes available. Remote quotes are fetched from the server and appear here when available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتوفر اقتباسات عن بُعد. تُجلب الاقتباسات عن بُعد من الخادم وتظهر هنا عند توفرها."
