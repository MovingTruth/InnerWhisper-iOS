        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цитаты обновлены. Закрой и снова открой Inner Whisper, чтобы обновить меню и кнопки во всём приложении."
          }
        },
        "th" : {
