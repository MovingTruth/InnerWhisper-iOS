    "Quotes have updated. Close and reopen Inner Whisper to update menus and buttons throughout the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحديث الاقتباسات. أغلق Inner Whisper وأعد فتحه لتحديث القوائم والأزرار في جميع أنحاء التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zitate wurden aktualisiert. Schließe Inner Whisper und öffne es erneut, um Menüs und Schaltflächen in der gesamten App zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las citas se han actualizado. Cierra Inner Whisper y vuelve a abrirlo para actualizar los menús y botones en toda la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les citations ont été mises à jour. Ferme Inner Whisper et rouvre-le pour mettre à jour les menus et boutons dans toute l'application."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引用文を更新しました。アプリ全体のメニューとボタンを更新するには、Inner Whisperを閉じてから再度開いてください。"
