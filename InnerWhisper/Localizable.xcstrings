    "Cannot disable — at least one collection must remain active" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التعطيل — يجب أن تبقى مجموعة واحدة على الأقل نشطة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann nicht deaktiviert werden — mindestens eine Sammlung muss aktiv bleiben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede desactivar — al menos una colección debe permanecer activa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible à désactiver — au moins une collection doit rester active"
          }
