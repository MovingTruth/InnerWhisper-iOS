    "Double tap to open this quote on the main screen. Long press to copy, share, or add to favorites." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر مرتين لفتح هذا الاقتباس في الشاشة الرئيسية. اضغط مطولًا للنسخ أو المشاركة أو الإضافة إلى المفضلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen, um dieses Zitat auf dem Hauptbildschirm zu öffnen. Lange drücken zum Kopieren, Teilen oder Hinzufügen zu Favoriten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doble toque para abrir esta cita en la pantalla principal. Mantén pulsado para copiar, compartir o añadir a favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tapez pour ouvrir cette citation sur l'écran principal. Appui long pour copier, partager ou ajouter aux favoris."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップしてこの引用をメイン画面で開きます。長押しでコピー、共有、またはお気に入りに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 번 탭하여 이 인용구를 메인 화면에서 여세요. 길게 눌러 복사, 공유하거나 즐겨찾기에 추가할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes para abrir esta citação na tela principal. Mantenha pressionado para copiar, compartilhar ou adicionar aos favoritos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснись, чтобы открыть эту цитату на главном экране. Удерживай, чтобы скопировать, поделиться или добавить в избранное."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะสองครั้งเพื่อเปิดคำคมนี้บนหน้าจอหลัก แตะค้างเพื่อคัดลอก แชร์ หรือเพิ่มลงในรายการโปรด"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击以在主屏幕打开这条语录。长按可复制、分享或添加到收藏。"
          }
        }
      }
    },
    "Double tap to open this quote on the main screen. Swipe right to share or copy. Swipe left to remove from favorites. Long press for more options." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر مرتين لفتح هذا الاقتباس في الشاشة الرئيسية. اسحب لليسار للمشاركة أو النسخ. اسحب لليمين للإزالة من المفضلة. اضغط مطولًا لمزيد من الخيارات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen, um dieses Zitat auf dem Hauptbildschirm zu öffnen. Nach rechts wischen zum Teilen oder Kopieren. Nach links wischen, um es aus den Favoriten zu entfernen. Lange drücken für weitere Optionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doble toque para abrir esta cita en la pantalla principal. Desliza a la derecha para compartir o copiar. Desliza a la izquierda para quitarla de favoritos. Mantén pulsado para más opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tapez pour ouvrir cette citation sur l'écran principal. Balayez vers la droite pour partager ou copier. Balayez vers la gauche pour la retirer des favoris. Appui long pour plus d'options."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップしてこの引用をメイン画面で開きます。右にスワイプして共有またはコピー。左にスワイプしてお気に入りから削除。長押しでその他のオプション。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 번 탭하여 이 인용구를 메인 화면에서 여세요. 오른쪽으로 스와이프하면 공유 또는 복사, 왼쪽으로 스와이프하면 즐겨찾기에서 제거됩니다. 길게 누르면 더 많은 옵션이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes para abrir esta citação na tela principal. Deslize para a direita para compartilhar ou copiar. Deslize para a esquerda para remover dos favoritos. Mantenha pressionado para mais opções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснись, чтобы открыть эту цитату на главном экране. Проведи вправо, чтобы поделиться или скопировать. Проведи влево, чтобы удалить из избранного. Удерживай для дополнительных параметров."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะสองครั้งเพื่อเปิดคำคมนี้บนหน้าจอหลัก ปัดขวาเพื่อแชร์หรือคัดลอก ปัดซ้ายเพื่อนำออกจากรายการโปรด แตะค้างเพื่อดูตัวเลือกเพิ่มเติม"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击以在主屏幕打开这条语录。向右轻扫可分享或复制。向左轻扫可从收藏中移除。长按可查看更多选项。"
          }
        }
      }
