    "Plays with each quote notification. Tap the speaker icon to preview." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغَّل مع كل إشعار اقتباس. انقر على أيقونة مكبر الصوت للمعاينة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
