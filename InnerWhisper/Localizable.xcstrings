    "Shows the next inspirational quote. Double tap or swipe left to activate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض الاقتباس الملهم التالي. انقر مرتين أو اسحب لليمين للتفعيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt das nächste inspirierende Zitat. Doppeltippen oder nach links wischen zum Aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la siguiente cita inspiradora. Doble toque o desliza a la izquierda para activar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la citation inspirante suivante. Double-tapez ou balayez vers la gauche pour activer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のインスピレーションを与える引用を表示します。ダブルタップまたは左にスワイプして操作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 영감을 주는 인용구를 표시합니다. 두 번 탭하거나 왼쪽으로 스와이프하여 실행하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a próxima citação inspiradora. Toque duas vezes ou deslize para a esquerda para ativar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает следующую вдохновляющую цитату. Дважды коснись или проведи влево, чтобы активировать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงคำคมสร้างแรงบันดาลใจถัดไป แตะสองครั้งหรือปัดซ้ายเพื่อเปิดใช้งาน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示下一条鼓舞人心的语录。双击或向左轻扫以激活。"
          }
        }
      }
    },
