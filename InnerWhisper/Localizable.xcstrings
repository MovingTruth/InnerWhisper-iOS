    "Quotes arrive without opening the app — on your lock screen and, if you have one, on your wrist." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل الاقتباسات دون فتح التطبيق — على شاشة القفل، وعلى معصمك إن كانت لديك ساعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zitate erreichen dich, ohne die App zu öffnen — auf deinem Sperrbildschirm und, falls vorhanden, an deinem Handgelenk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las citas te llegan sin abrir la app — en tu pantalla de bloqueo y, si tienes uno, en tu muñeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les citations vous parviennent sans ouvrir l'application — sur votre écran verrouillé et, si vous en avez une, à votre poignet."
          }
