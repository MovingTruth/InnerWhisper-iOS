    "Inner Whisper works entirely offline. No account required, no analytics, no data leaves your device" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Inner Whisper بلا اتصال بالإنترنت بالكامل. لا حاجة لحساب، ولا تحليلات، ولا تغادر أي بيانات جهازك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper funktioniert vollständig offline. Kein Konto erforderlich, keine Analyse, keine Daten verlassen dein Gerät"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper funciona completamente sin conexión. No se requiere cuenta, sin análisis, ningún dato sale de tu dispositivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper fonctionne entièrement hors ligne. Aucun compte requis, aucune analyse, aucune donnée ne quitte votre appareil"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisperは完全にオフラインで動作します。アカウント不要、解析なし、データが端末から出ることはありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper는 완전히 오프라인으로 작동합니다. 계정이 필요 없고, 분석 도구도 없으며, 어떤 데이터도 기기 밖으로 나가지 않습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Inner Whisper funciona totalmente offline. Nenhuma conta é necessária, sem análises, nenhum dado sai do seu dispositivo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper полностью работает офлайн. Аккаунт не нужен, аналитика не используется, никакие данные не покидают твоё устройство"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper ทำงานแบบออฟไลน์ทั้งหมด ไม่ต้องสร้างบัญชี ไม่มีการวิเคราะห์ข้อมูล ไม่มีข้อมูลใดออกจากอุปกรณ์ของคุณ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inner Whisper 完全离线运行。无需账户，不进行数据分析，任何数据都不会离开你的设备"
          }
        }
      }
    },
    "InnerWhisper encrypts your settings and data on-device. No accounts, no tracking. Favourites can optionally sync via iCloud." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشفّر InnerWhisper إعداداتك وبياناتك على جهازك. لا حسابات، ولا تتبع. يمكن مزامنة المفضلة اختياريًا عبر iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper verschlüsselt Einstellungen und Daten auf dem Gerät. Keine Konten, kein Tracking. Favoriten können optional über iCloud synchronisiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper cifra tu configuración y datos en el dispositivo. Sin cuentas, sin seguimiento. Los favoritos pueden sincronizarse con iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper chiffre vos paramètres et données sur l'appareil. Pas de comptes, pas de suivi. Les favoris peuvent se synchroniser via iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisperは設定とデータをデバイス上で暗号化します。アカウントなし、トラッキングなし。お気に入りはiCloud経由でオプション同期できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper는 기기에서 설정과 데이터를 암호화합니다. 계정도, 추적도 없습니다. 즐겨찾기는 원할 경우 iCloud를 통해 동기화할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O InnerWhisper criptografa suas configurações e dados no dispositivo. Sem contas, sem rastreamento. Os favoritos podem sincronizar opcionalmente via iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper шифрует твои настройки и данные прямо на устройстве. Никаких аккаунтов, никакого отслеживания. Избранное может по желанию синхронизироваться через iCloud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper เข้ารหัสการตั้งค่าและข้อมูลของคุณบนอุปกรณ์ ไม่มีบัญชี ไม่มีการติดตาม รายการโปรดสามารถซิงค์ผ่าน iCloud ได้ตามต้องการ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper 会在设备本地加密你的设置和数据。无需账户，不进行追踪。收藏内容可选择通过 iCloud 同步。"
          }
        }
      }
    },
    "InnerWhisper holds over 250 hand-curated inspirational quotes — each one chosen to spark reflection, motivation, and clarity." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضم InnerWhisper أكثر من 250 اقتباسًا ملهمًا منتقى بعناية — اختير كل منها لإيقاظ التأمل والتحفيز والوضوح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper enthält über 250 handverlesene inspirierende Zitate — jedes ausgewählt, um Reflexion und Motivation zu wecken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper tiene más de 250 citas inspiradoras seleccionadas a mano — cada una para despertar reflexión y motivación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper contient plus de 250 citations inspirantes — chacune choisie pour susciter réflexion et motivation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisperには250以上の厳選されたインスピレーションの引用があります — それぞれが内省と動機を呼び起こすために選ばれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper에는 250개가 넘는 엄선된 영감의 인용구가 담겨 있습니다 — 하나하나가 성찰과 동기부여, 명료함을 일깨우도록 선택되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O InnerWhisper reúne mais de 250 citações inspiradoras selecionadas a dedo — cada uma escolhida para despertar reflexão, motivação e clareza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper хранит более 250 отобранных вручную вдохновляющих цитат — каждая выбрана, чтобы пробуждать размышление, мотивацию и ясность."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper รวบรวมคำคมสร้างแรงบันดาลใจที่คัดสรรด้วยมือกว่า 250 บท — แต่ละบทถูกเลือกมาเพื่อจุดประกายการใคร่ครวญ แรงจูงใจ และความกระจ่างชัด"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InnerWhisper 收录了超过 250 条精心甄选的鼓舞人心语录——每一条都旨在启发反思、激励前行、带来清明。"
          }
        }
      }
    },
