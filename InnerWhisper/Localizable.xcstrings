    "Quotes appear as banners the moment they arrive. Pick up your phone and one is already waiting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الاقتباسات كإشعارات فور وصولها. أمسك هاتفك وستجد واحدًا في انتظارك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zitate erscheinen als Banner, sobald sie eintreffen. Nimm dein Telefon zur Hand — eines wartet bereits auf dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las citas aparecen como banners en el momento en que llegan. Toma tu teléfono y una ya te estará esperando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les citations apparaissent sous forme de bannières dès leur arrivée. Prenez votre téléphone, une citation vous attend déjà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引用は届いた瞬間にバナーとして表示されます。スマートフォンを手に取ると、すでに一つ待っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인용구는 도착하는 즉시 배너로 나타납니다. 휴대폰을 집어 들면 이미 하나가 기다리고 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As citações aparecem como banners no momento em que chegam. Pegue o telefone e uma já estará esperando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цитаты появляются в виде баннеров в момент прихода. Возьми телефон в руки — и одна уже ждёт тебя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำคมจะปรากฏเป็นแบนเนอร์ในทันทีที่มาถึง หยิบโทรศัพท์ขึ้นมา แล้วคำคมหนึ่งก็รอคุณอยู่แล้ว"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语录会以横幅通知的形式，在送达的那一刻出现。拿起手机，早已有一句在等你。"
          }
        }
      }
    },
    "Quotes appear as notifications — right when you pick up your phone" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الاقتباسات كإشعارات — بمجرد أن تُمسك هاتفك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zitate erscheinen als Benachrichtigungen — genau dann, wenn Sie Ihr Telefon aufnehmen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las citas aparecen como notificaciones — justo cuando coges el teléfono"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les citations apparaissent comme des notifications — juste quand vous prenez votre téléphone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引用は通知として表示されます。スマートフォンを手に取ったときに"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인용구가 알림으로 나타납니다 — 휴대폰을 집어 드는 바로 그 순간에"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As citações aparecem como notificações — bem quando você pega o telefone"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цитаты появляются как уведомления — именно тогда, когда ты берёшь телефон в руки"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำคมปรากฏเป็นการแจ้งเตือน — ในทันทีที่คุณหยิบโทรศัพท์ขึ้นมา"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语录会以通知的形式出现——就在你拿起手机的那一刻"
          }
        }
      }
    },
    "Quotes are appearing grouped by collection, in their original order." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الاقتباسات مجمّعة حسب المجموعة، بترتيبها الأصلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zitate werden nach Sammlung gruppiert in ihrer ursprünglichen Reihenfolge angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
