    "Turn off “My quotes only” above to browse all collections, or use the + button to add your own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف تفعيل «اقتباساتي فقط» أعلاه لتصفح جميع المجموعات، أو استخدم زر + لإضافة اقتباساتك الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren Sie oben „Nur meine Zitate“, um alle Sammlungen zu durchsuchen, oder verwenden Sie die +-Schaltfläche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva “Solo mis citas” arriba para ver todas las colecciones, o usa el botón +."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez « Mes citations uniquement » ci-dessus pour toutes les collections, ou utilisez le bouton +."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自分の引用のみ」をオフにしてすべてのコレクションを参照するか、＋ボタンで追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 컬렉션을 둘러보려면 위의 '내 인용구만'을 끄거나, + 버튼으로 나만의 인용구를 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative \"Somente minhas citações\" acima para navegar por todas as coleções, ou use o botão + para adicionar a sua própria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключи «Только мои цитаты» выше, чтобы просматривать все коллекции, или нажми «+», чтобы добавить свою цитату."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด \"คำคมของฉันเท่านั้น\" ด้านบนเพื่อเรียกดูทุกคอลเลกชัน หรือใช้ปุ่ม + เพื่อเพิ่มคำคมของคุณเอง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭上方的“仅显示我的语录”即可浏览所有合集，或使用 + 按钮添加你自己的语录。"
          }
        }
      }
    },
