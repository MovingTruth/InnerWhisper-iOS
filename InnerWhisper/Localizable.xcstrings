    "Encryption keys are generated locally and never sent to a server" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنشأ مفاتيح التشفير محليًا ولا تُرسل أبدًا إلى أي خادم"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselungsschlüssel werden lokal generiert und nie an einen Server gesendet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de cifrado se generan localmente y nunca se envían a un servidor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés de chiffrement sont générées localement et ne sont jamais envoyées à un serveur"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化キーはローカルで生成され、サーバーには送信されません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화 키는 기기에서 생성되며 서버로 전송되지 않습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de criptografia são geradas localmente e nunca enviadas a um servidor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи шифрования создаются локально и никогда не отправляются на сервер"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กุญแจเข้ารหัสถูกสร้างขึ้นในเครื่องและไม่เคยถูกส่งไปยังเซิร์ฟเวอร์"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密密钥在本地生成，绝不会发送到服务器"
          }
        }
      }
    },
    "Encryption keys are generated on your device and default to local-only storage — they are never sent to a server" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنشأ مفاتيح التشفير على جهازك ويكون تخزينها محليًا فقط بشكل افتراضي — ولا تُرسل أبدًا إلى أي خادم"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselungsschlüssel werden auf Ihrem Gerät generiert und standardmäßig nur lokal gespeichert — sie werden nie an einen Server gesendet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de cifrado se generan en tu dispositivo y se almacenan solo localmente — nunca se envían a un servidor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés de chiffrement sont générées sur votre appareil et stockées uniquement en local — elles ne sont jamais envoyées à un serveur"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化キーはデバイス上で生成され、デフォルトでローカルのみに保存されます。サーバーには送信されません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화 키는 기기에서 생성되며 기본적으로 로컬에만 저장됩니다 — 서버로 전송되지 않습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de criptografia são geradas no seu dispositivo e armazenadas apenas localmente por padrão — nunca são enviadas a um servidor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи шифрования создаются на твоём устройстве и по умолчанию хранятся только локально — они никогда не отправляются на сервер"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กุญแจเข้ารหัสถูกสร้างขึ้นบนอุปกรณ์ของคุณและจัดเก็บในเครื่องเป็นค่าเริ่มต้น — ไม่เคยถูกส่งไปยังเซิร์ฟเวอร์"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密密钥在你的设备上生成，默认仅存储在本地——绝不会发送到服务器"
          }
        }
      }
    },
    "Encryption keys are generated on your device and stored locally. iCloud Keychain sync is disabled by default to prevent nonce-reuse across devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنشأ مفاتيح التشفير على جهازك وتُخزَّن محليًا. مزامنة سلسلة مفاتيح iCloud معطّلة افتراضيًا لمنع إعادة استخدام قيمة nonce عبر الأجهزة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselungsschlüssel werden auf Ihrem Gerät generiert und lokal gespeichert. iCloud-Schlüsselbundsynchonisierung ist standardmäßig deaktiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves se generan en tu dispositivo y se almacenan localmente. La sincronización con el llavero de iCloud está desactivada por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés de chiffrement sont générées sur votre appareil et stockées localement. La synchronisation avec le trousseau iCloud est désactivée par défaut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化キーはデバイス上で生成されローカルに保存されます。iCloudキーチェーン同期はデフォルトで無効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화 키는 기기에서 생성되어 로컬에 저장됩니다. 기기 간 논스(nonce) 재사용을 방지하기 위해 iCloud 키체인 동기화는 기본적으로 비활성화되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de criptografia são geradas no seu dispositivo e armazenadas localmente. A sincronização com o Chaveiro do iCloud é desativada por padrão para evitar a reutilização de nonce entre dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи шифрования создаются на твоём устройстве и хранятся локально. Синхронизация со связкой ключей iCloud по умолчанию отключена, чтобы избежать повторного использования nonce на разных устройствах."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กุญแจเข้ารหัสถูกสร้างขึ้นบนอุปกรณ์ของคุณและจัดเก็บในเครื่อง การซิงค์ iCloud Keychain ถูกปิดใช้งานเป็นค่าเริ่มต้นเพื่อป้องกันการใช้ nonce ซ้ำระหว่างอุปกรณ์"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密密钥在你的设备上生成并存储于本地。为防止跨设备重复使用随机数（nonce），iCloud 钥匙串同步默认处于关闭状态。"
          }
        }
      }
    },
